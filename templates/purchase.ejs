<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <style>
    @page {
      size: A4;
      margin: 0;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Arial', sans-serif;
      font-size: 12px;
      position: relative;
      width: 210mm;
      min-height: 297mm;
    }

    .letterhead-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      background-image: url('<%= process.env.BASE_URL %>files/letterhead3.jpg');
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center top;
    }

    .container {
      padding: 100px 40px 80px 40px;
      position: relative;
      z-index: 2;
    }

    .top-right {
      position: absolute;
      top: 30px;
      right: 40px;
      font-size: 11px;
      color: #333;
    }

    .header {
      text-align: center;
      margin-bottom: 30px;
      padding-top: 10px;
    }

    .header img {
      width: 140px;
      margin-bottom: 10px;
    }

    .company-name {
      font-size: 20px;
      font-weight: bold;
      margin-top: 10px;
      letter-spacing: 1px;
    }

    .section {
      display: flex;
      justify-content: space-between;
      margin-top: 25px;
      gap: 20px;
    }

    .left, .right {
      width: 48%;
      line-height: 1.8;
    }

    .left p, .right p {
      margin: 4px 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 25px;
      font-size: 12px;
    }

    th, td {
      border: 1px solid #333;
      padding: 8px 6px;
      text-align: center;
    }

    th {
      background-color: #f0f0f0;
      font-weight: bold;
    }

    td:nth-child(2) {
      text-align: left;
      padding-left: 10px;
    }

    .summary {
      margin-top: 25px;
      float: right;
      width: 280px;
      clear: both;
    }

    .summary table {
      width: 100%;
      border-collapse: collapse;
    }

    .summary td {
      border: 1px solid #333;
      padding: 8px 10px;
      text-align: right;
    }

    .summary td:first-child {
      text-align: left;
      font-weight: 500;
    }

    .footer {
      text-align: center;
      font-size: 10px;
      margin-top: 100px;
      clear: both;
    }

  </style>
</head>

<body>
  <div class="letterhead-bg"></div>

  <div class="container">
    <div class="top-right">
      <strong>Generated on:</strong> <%= new Date().toLocaleDateString('en-GB') %>
    </div>

    <div class="header">
      <!-- <img src="<%= process.env.BASE_URL %>/files/logo.png" alt="Logo" /> -->
      <div class="company-name">NOBLE DIAGNOSTICS</div>
    </div>

    <div class="section">
      <div class="left">
        <p><strong>Supplier:</strong> <%= data?.supplier?.[0]?.name %></p>
        <p><strong>Address:</strong> <%= data?.supplier?.[0]?.address %></p>
        <p><strong>GSTIN:</strong> <%= data?.supplier?.[0]?.gstIn || '___________' %></p>
        <br />
        <p><strong>Customer Name:</strong> Thana, Kannur</p>
        <p><strong>Address:</strong> Kakkad Road, Thana, Kannur</p>
        <p><strong>GSTIN:</strong> </p>
      </div>

      <div class="right">
        <p><strong>Invoice ID:</strong> <%= data?.invoiceId %></p>
        <p><strong>Request ID:</strong> <%= data?.requestId %></p>
        <p><strong>Invoice Date:</strong> <%= data?.date %></p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Product</th>
          <th>Qty</th>
          <th>Unit</th>
          <th>Rate</th>
          <th>GST %</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% data.items.forEach((item, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= item.name %></td>
            <td><%= item.quantity %></td>
            <td><%= item.unit || '' %></td>
            <td>₹ <%= item.rate?.toFixed(2) %></td>
            <td><%= item.gst %>%</td>
            <td>₹ <%= (item.amount + (item.amount * item.gst / 100)).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="summary">
      <table>
        <tr>
          <td><strong>Taxable:</strong></td>
          <td>₹ <%= data?.taxableAmount?.toFixed(2) %></td>
        </tr>
        <tr>
          <td><strong>GST:</strong></td>
          <td>₹ <%= data?.gstAmount?.toFixed(2) %></td>
        </tr>
        <tr>
          <td><strong>Net Total:</strong></td>
          <td><strong>₹ <%= data?.grandTotal?.toFixed(2) %></strong></td>
        </tr>
      </table>
    </div>
  </div>
</body>
</html>
